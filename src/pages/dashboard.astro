---
import Base from '../layouts/Base.astro';
import { fetchSnapshot, loadSnapshot } from '../lib/snapshot';
import { renderDashboard } from '../lib/dashboard-view';

const base = import.meta.env.BASE_URL;

const METRICS_URL =
  'https://raw.githubusercontent.com/nplus-father/bookshelf-echo-site/data/metrics/latest.json';

const snap = (await loadSnapshot()) ?? (await fetchSnapshot(METRICS_URL));
const initial = renderDashboard(snap, new Date());
---

<Base
  title="Bookshelf Echo — 系統健康"
  description="bookshelf-echo pipeline 的健康指標：佇列深度、項目狀態、LLM 花費與 DLQ"
>
  <p><a class="back" href={base}>← 回首頁</a></p>

  <h2>系統健康</h2>

  <div id="dash" data-src={METRICS_URL} set:html={initial}></div>
</Base>

<script>
  import { renderDashboard } from '../lib/dashboard-view';

  const host = document.getElementById('dash');
  const src = host?.dataset.src;
  if (host && src) {
    fetch(src, { cache: 'no-store' })
      .then((r) => (r.ok ? r.json() : null))
      .then((json) => {
        if (json) host.innerHTML = renderDashboard(json, new Date());
      })
      .catch(() => {
      });
  }
</script>

<style is:global>

  #dash .viz {
    --series-1: #2a78d6;
    --sev-accent: #2a78d6;
    --sev-good: #0ca30c;
    --sev-warning: #fab219;
    --sev-critical: #d03b3b;
  }
  @media (prefers-color-scheme: dark) {
    #dash .viz {
      --series-1: #3987e5;
      --sev-accent: #3987e5;
    }
  }

  #dash .captured,
  #dash .empty {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 1.25rem;
  }
  #dash .captured .chip {
    margin-left: 0.5rem;
  }

  #dash .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem 1.1rem;
  }
  #dash .label {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0;
  }
  #dash .hero-value {
    font-size: 3rem;
    font-weight: 600;
    line-height: 1.15;
    margin: 0.2rem 0 0.6rem;
  }
  #dash .value {
    font-size: 1.6rem;
    font-weight: 600;
    margin: 0.15rem 0 0.5rem;
  }
  #dash .value .of {
    color: var(--muted);
    font-size: 1rem;
    font-weight: 400;
  }
  #dash .sub {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  #dash .sub.muted {
    color: var(--muted);
  }

  #dash .meter {
    height: 8px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--meter) 22%, var(--card));
    overflow: hidden;
  }
  #dash .meter-fill {
    display: block;
    height: 100%;
    width: var(--fill);
    background: var(--meter);
    border-radius: 999px;
  }

  #dash .kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  #dash .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    white-space: nowrap;
    color: var(--fg);
  }
  #dash .chip .ico {
    display: inline-grid;
    place-items: center;
    width: 1.05em;
    height: 1.05em;
    border-radius: 50%;
    font-size: 0.72em;
    font-weight: 700;
    color: #fff;
  }
  #dash .chip-good .ico {
    background: var(--sev-good);
  }
  #dash .chip-warning .ico {
    background: var(--sev-warning);
    color: #1a1a19;
  }
  #dash .chip-critical .ico {
    background: var(--sev-critical);
  }

  #dash .bars {
    display: grid;
    gap: 0.5rem;
  }
  #dash .bar-row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    align-items: center;
    gap: 0.75rem;
  }
  #dash .bar-label {
    color: var(--muted);
    font-size: 0.85rem;
  }
  #dash .bar-track {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  #dash .bar {
    height: 14px;
    width: calc(var(--w) * (100% - 4rem));
    background: var(--series-1);
    border-radius: 0 4px 4px 0;
    flex: 0 0 auto;
  }
  #dash .bar-value {
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }

  #dash .table-wrap {
    overflow-x: auto;
  }
  #dash table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  #dash th,
  #dash td {
    text-align: left;
    padding: 0.45rem 0.6rem 0.45rem 0;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  #dash th {
    color: var(--muted);
    font-weight: 500;
  }
  #dash .n {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  #dash td.n {
    white-space: nowrap;
  }
  #dash td.n .chip {
    margin-left: 0.4rem;
  }
  #dash .depth-col {
    width: 45%;
  }
  #dash td.depth-col {
    padding-right: 1rem;
  }
  #dash .qbar {
    display: block;
    height: 10px;
    min-width: 0;
    background: var(--series-1);
    border-radius: 0 4px 4px 0;
  }
  #dash .foot-note {
    color: var(--muted);
    font-size: 0.8rem;
    margin-top: 0.9rem;
  }
</style>
