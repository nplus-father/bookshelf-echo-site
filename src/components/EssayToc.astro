---
import { bookSiteUrl, chapterUrl, type EssayBook } from '../lib/library';

interface Props {
  headings: { depth: number; slug: string; text: string }[];
  books?: EssayBook[];
}
const { headings, books = [] } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const mode: 'headings' | 'books' | 'none' =
  tocHeadings.length >= 2 ? 'headings' : books.length > 0 ? 'books' : 'none';
const bookLinks = books.map((b) => ({
  title: b.title,
  chapter: b.chapter,
  href: (b.chapter_id ? chapterUrl(b.chapter_id) : null) ?? (b.slug ? bookSiteUrl(b.slug) : null),
}));
const label = mode === 'headings' ? '本篇章節' : '本篇引用';
---

{
  mode !== 'none' && (
    <nav class="toc" aria-label={label}>
      <details class="toc-box" open>
        <summary>{label}</summary>
        <ol>
          {mode === 'headings'
            ? tocHeadings.map((h) => (
                <li class={`toc-d${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))
            : bookLinks.map((b) => (
                <li>
                  {b.href ? (
                    <a href={b.href} target="_blank" rel="noopener noreferrer">
                      {b.title}
                    </a>
                  ) : (
                    <span>{b.title}</span>
                  )}
                  {b.chapter && <span class="toc-chapter">{b.chapter}</span>}
                </li>
              ))}
        </ol>
      </details>
    </nav>
  )
}
